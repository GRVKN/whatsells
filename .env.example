# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Shopify app
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_APP_URL="https://app.whatsells.dev"
SCOPES="read_orders,read_products"
SHOP_CUSTOM_DOMAIN=""

# Public tracking
TRACK_BASE_URL="https://app.whatsells.dev"
VITE_TRACK_BASE_URL="https://app.whatsells.dev"
# Optional: if omitted, SHOPIFY_API_SECRET is used for keyed IP pseudonyms.
IP_HASH_SECRET=""

# Shopify managed pricing / Partner API
SHOPIFY_APP_HANDLE="whatsells-1"
SHOPIFY_BASIC_PLAN_HANDLE="basic"
SHOPIFY_PRO_PLAN_HANDLE="pro"
SHOPIFY_EXPERT_PLAN_HANDLE="expert"
SHOPIFY_APP_GID=""
SHOPIFY_PARTNER_API_TOKEN=""
SHOPIFY_PARTNER_ORG_ID=""
SHOPIFY_PARTNER_API_VERSION="2026-07"

# Expert operator and AI copilot
# Use a long random secret and send it as `Authorization: Bearer ...` when a
# scheduler posts to /api/expert/daily.
EXPERT_CRON_SECRET=""

# Scores, actions and safeguards work without AI. Keep false until all
# server-side credentials and spend limits are configured.
EXPERT_AI_ENABLED="false"
EXPERT_WEB_SEARCH_ENABLED="false"
OPENAI_API_KEY=""
OPENAI_FAST_MODEL="gpt-5.6-luna"
OPENAI_EXPERT_MODEL="gpt-5.6-terra"
OPENAI_DEEP_MODEL="gpt-5.6-sol"
OPENAI_IMAGE_MODEL="gpt-image-2"

# Per-merchant monthly allowances and internal estimated-cost guard.
# 6,000,000 micros = US$6.00.
EXPERT_MONTHLY_CHAT_LIMIT="100"
EXPERT_MONTHLY_MARKET_LIMIT="8"
EXPERT_MONTHLY_CAMPAIGN_LIMIT="20"
EXPERT_MONTHLY_IMAGE_LIMIT="20"
EXPERT_MONTHLY_COST_LIMIT_MICROS="6000000"

# Private Supabase Storage for generated Expert assets. Never expose the
# service-role key to browser code or VITE_* variables.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
EXPERT_ASSET_BUCKET="whatsells-expert"
